FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir \
    langchain==0.1.0 \
    langchain-openai==0.0.5 \
    openai==1.3.0 \
    jinja2==3.1.2 \
    redis==5.0.0 \
    pydantic==2.5.0 \
    pydantic-settings==2.1.0

# Copy application code
COPY app/ ./app/

# Copy prompt templates
COPY app/bot/nlu/llm/prompts/ ./app/bot/nlu/llm/prompts/

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV OPENAI_API_KEY=${OPENAI_API_KEY}
ENV LLM_BASE_URL=${LLM_BASE_URL:-http://127.0.0.1:11434/v1}
ENV MODEL_NAME=${MODEL_NAME:-mistral}
ENV CACHE_ENABLED=${CACHE_ENABLED:-true}
ENV REDIS_HOST=${REDIS_HOST:-localhost}
ENV REDIS_PORT=${REDIS_PORT:-6379}
ENV REDIS_DB=${REDIS_DB:-0}
ENV REQUEST_TIMEOUT=${REQUEST_TIMEOUT:-30}
ENV MAX_REQUESTS_PER_MINUTE=${MAX_REQUESTS_PER_MINUTE:-60}
ENV LOG_LEVEL=${LOG_LEVEL:-INFO}

# Default command
CMD ["python", "-m", "app.bot.nlu.llm.service"]